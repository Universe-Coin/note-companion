{
  "cli": {
    "version": ">= 7.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "preview-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "corepack": true,
      "pnpm": "10.8.1",
      "env": {
        "EXPO_USE_PNPM": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6799668806",
        "appleTeamId": "BVPZUKJ47D"
      }
    }
  }
}
